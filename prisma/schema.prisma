generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ExamType {
  ONLINE
  PHYSICAL
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
}

model User {
  id               String             @id
  name             String
  email            String             @unique
  passwordHash     String
  role             UserRole
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  attendanceRecords AttendanceRecord[] @relation("MarkedByTeacher")
  todos            TodoItem[]
  sentMessages     Message[]           @relation("SentMessages")
  receivedMessages Message[]           @relation("ReceivedMessages")

  @@index([email])
  @@index([role])
  @@map("user")
}

model StudentProfile {
  id               String             @id
  userId           String             @unique
  rollNo           String
  class            String
  
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  enrollments      Enrollment[]
  grades           Grade[]
  answers          Answer[]

  @@index([rollNo])
  @@index([userId])
  @@map("studentprofile")
}

model TeacherProfile {
  id               String             @id
  userId           String             @unique
  department       String
  
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSubjects    ClassSubject[]
  createdExams     Exam[]
  gradedGrades     Grade[]

  @@index([userId])
  @@map("teacherprofile")
}

model Class {
  id               String             @id
  name             String             @unique
  createdAt        DateTime           @default(now())
  
  attendancerecords AttendanceRecord[]
  calendarevents   CalendarEvent[]
  classSubjects    ClassSubject[]
  enrollments      Enrollment[]
  exams            Exam[]

  @@index([name])
  @@map("class")
}

model Subject {
  id               String             @id
  name             String             @unique
  code             String?            @unique
  createdAt        DateTime           @default(now())
  
  classSubjects    ClassSubject[]
  exams            Exam[]
  calendarEvents   CalendarEvent[]

  @@index([name])
  @@map("subject")
}

model ClassSubject {
  id             String         @id
  classId        String
  subjectId      String
  teacherId      String
  
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("classsubject")
}

model Enrollment {
  id             String         @id
  studentId      String         @unique
  classId        String
  enrolledAt     DateTime       @default(now())
  
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId])
  @@map("enrollment")
}

model Exam {
  id                 String         @id
  classId            String
  subjectId          String
  title              String
  examType           ExamType
  scheduledAt        DateTime
  totalMarks         Int
  duration           String?
  createdByTeacherId String
  archived           Boolean        @default(false)
  
  class              Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher            TeacherProfile @relation(fields: [createdByTeacherId], references: [id])
  grades             Grade[]
  questions          Question[]

  @@index([classId])
  @@index([createdByTeacherId])
  @@index([scheduledAt])
  @@index([subjectId])
  @@index([archived])
  @@map("exam")
}

model Question {
  id              String       @id
  examId          String
  questionText    String
  questionType    QuestionType
  options         String?      @db.Text
  correctAnswer   String?
  marks           Int          @default(1)
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  exam            Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@index([examId])
  @@index([order])
  @@map("question")
}

model Answer {
  id          String     @id
  questionId String
  studentId   String
  answerText  String     @db.Text
  isCorrect   Boolean?
  marksObtained Int?
  createdAt   DateTime   @default(now())
  
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([questionId, studentId])
  @@index([questionId])
  @@index([studentId])
  @@map("answer")
}

model Grade {
  id                String         @id
  studentId         String
  examId            String
  marksObtained     Int?
  gradeLetter       String?
  remarks           String?
  gradedByTeacherId String
  gradedAt          DateTime       @default(now())
  
  exam              Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher           TeacherProfile @relation(fields: [gradedByTeacherId], references: [id])
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId])
  @@index([examId])
  @@index([gradedByTeacherId])
  @@index([studentId])
  @@map("grade")
}

model AttendanceRecord {
  id                String                  @id
  studentId         String
  classId           String
  date              DateTime
  status            AttendanceStatus
  markedByTeacherId String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  
  class             Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher           User                    @relation("MarkedByTeacher", fields: [markedByTeacherId], references: [id])
  student           StudentProfile          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([date])
  @@index([markedByTeacherId])
  @@index([studentId])
  @@map("attendancerecord")
}

model CalendarEvent {
  id           String        @id
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime?
  type         String
  audience     String?
  classId      String?
  subjectId    String?
  
  class        Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([subjectId])
  @@index([startAt])
  @@index([type])
  @@map("calendarevent")
}

model TodoItem {
  id          String    @id
  userId      String
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isCompleted])
  @@index([userId])
  @@map("todoitem")
}

model Message {
  id          String    @id
  senderId    String
  receiverId  String
  content     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("message")
}
